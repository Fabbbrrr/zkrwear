<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24"
    android:tint="#FFFFFFFF">
    <!-- Side-view car with an open rear tailgate (outline), like the official app. -->
    <group android:name="car">
        <!-- Body: front (right) hood up to roof, down to open rear (left). -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M5,15 L5,11 L8,7 L13,7 L16,11 L20,11.4 C20.6,11.5 21,11.9 21,12.5 L21,15" />
        <!-- Ground / underbody line between the wheels. -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M3,15 L21,15" />
        <!-- Raised tailgate lifted up from the rear roof. -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M8,7 L4,3.5" />
        <!-- Rear wheel -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.6"
            android:fillColor="#00000000"
            android:pathData="M8,15 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
        <!-- Front wheel -->
        <path
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.6"
            android:fillColor="#00000000"
            android:pathData="M17,15 m-2,0 a2,2 0 1,0 4,0 a2,2 0 1,0 -4,0" />
    </group>
</vector>
